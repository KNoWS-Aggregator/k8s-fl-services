@prefix aggr: <https://w3id.org/aggregator#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix hydra: <http://www.w3.org/ns/hydra/core#> .
@prefix fnoc: <https://fno.io/vocabulary/composition/0.1.0/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aggr:ServiceProfile
    a rdfs:Class ;
    rdfs:label "Service profile" ;
    rdfs:comment "Reusable profile of the runtime functions and HTTP API implemented by a service." .

aggr:Endpoint
    a rdfs:Class ;
    rdfs:label "Endpoint" ;
    rdfs:comment "An HTTP endpoint whose path is relative to a deployed service root." .

aggr:deploymentFunction
    a rdf:Property ;
    rdfs:label "deployment function" ;
    rdfs:comment "The FnO function used by a service request, and recorded on the service produced by that deployment." ;
    rdfs:range fno:Function .

aggr:supportsEndpoint
    a rdf:Property ;
    rdfs:domain aggr:ServiceProfile ;
    rdfs:range aggr:Endpoint .

aggr:composition
    a rdf:Property ;
    rdfs:domain aggr:ServiceProfile ;
    rdfs:range fnoc:Composition .

aggr:path
    a rdf:Property ;
    rdfs:domain aggr:Endpoint ;
    rdfs:range xsd:string .

aggr:executes
    a rdf:Property ;
    rdfs:domain hydra:Operation ;
    rdfs:range fno:Function .

aggr:updatesParameter
    a rdf:Property ;
    rdfs:domain hydra:Operation ;
    rdfs:range fno:Parameter .

aggr:returnsOutput
    a rdf:Property ;
    rdfs:domain hydra:Operation ;
    rdfs:range fno:Output .

aggr:returnsParameter
    a rdf:Property ;
    rdfs:domain hydra:Operation ;
    rdfs:range fno:Parameter .
