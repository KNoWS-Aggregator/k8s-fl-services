@prefix aggr: <https://w3id.org/aggregator#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .

<https://aggregator.example/services/weight-aggregation-1>
    a aggr:Service, dcat:DataService ;
    aggr:deploymentFunction
        <https://example.org/k8s-fl-services/weight-aggregation/deploy> ;
    dcat:endpointURL
        <https://aggregator.example/services/weight-aggregation-1/> ;
    dcat:servesDataset
        <https://aggregator.example/services/weight-aggregation-1#evaluation-metrics> .

<https://aggregator.example/services/weight-aggregation-1#evaluation-metrics>
    a dcat:Dataset ;
    dcat:distribution
        <https://aggregator.example/services/weight-aggregation-1#evaluation-metrics-distribution> .

<https://aggregator.example/services/weight-aggregation-1#evaluation-metrics-distribution>
    a dcat:Distribution ;
    dcat:mediaType
        <https://www.iana.org/assignments/media-types/application/json> ;
    dcat:accessURL
        <https://aggregator.example/services/weight-aggregation-1/evaluation-metrics> ;
    dcat:accessService
        <https://aggregator.example/services/weight-aggregation-1> .

# Global and client weights remain private persistent state and are not
# advertised as datasets.
