@base <https://example.org/k8s-fl-services/weight-aggregation/> .
@prefix aggr: <https://w3id.org/aggregator#> .
@prefix hydra: <http://www.w3.org/ns/hydra/core#> .

<profile>
    a aggr:ServiceProfile ;
    aggr:performs
        <startSession>,
        <aggregateWeights>,
        <aggregateEvaluationMetrics> ;
    aggr:supportsEndpoint
        <session-start-endpoint>,
        <training-results-endpoint>,
        <evaluation-results-endpoint>,
        <evaluation-metrics-endpoint>,
        <status-endpoint>,
        <health-endpoint>,
        <readiness-endpoint> .

<session-start-endpoint>
    a aggr:Endpoint ;
    aggr:path "/session/start" ;
    hydra:supportedOperation <session-start-operation> .

<session-start-operation>
    a hydra:Operation ;
    hydra:method "POST" ;
    aggr:executes <startSession> ;
    aggr:updatesParameter
        <expectedRounds>, <minimumClients>, <roundTimeout>, <trainingConfig> ;
    aggr:returnsOutput <startedSessionId> .

<training-results-endpoint>
    a aggr:Endpoint ;
    aggr:path "/training-results" ;
    hydra:supportedOperation <training-results-operation> .

<training-results-operation>
    a hydra:Operation ;
    hydra:method "POST" ;
    aggr:executes <aggregateWeights> ;
    aggr:updatesParameter
        <sessionId>,
        <roundId>,
        <clientId>,
        <clientWeights>,
        <trainingMetrics>,
        <currentAggregatedWeights> .

<evaluation-results-endpoint>
    a aggr:Endpoint ;
    aggr:path "/evaluation-results" ;
    hydra:supportedOperation <evaluation-results-operation> .

<evaluation-results-operation>
    a hydra:Operation ;
    hydra:method "POST" ;
    aggr:executes <aggregateEvaluationMetrics> ;
    aggr:updatesParameter
        <sessionId>,
        <roundId>,
        <clientId>,
        <clientEvaluationMetrics>,
        <currentAggregatedEvaluationMetrics> .

<evaluation-metrics-endpoint>
    a aggr:Endpoint ;
    aggr:path "/evaluation-metrics" ;
    hydra:supportedOperation <get-evaluation-metrics-operation> .

<get-evaluation-metrics-operation>
    a hydra:Operation ;
    hydra:method "GET" ;
    aggr:returnsOutput <aggregatedEvaluationMetrics> .

<status-endpoint>
    a aggr:Endpoint ;
    aggr:path "/status" ;
    hydra:supportedOperation <get-status-operation> .

<get-status-operation>
    a hydra:Operation ;
    hydra:method "GET" ;
    aggr:returnsParameter
        <sessionId>, <registeredClients>, <trainableClients> .

<health-endpoint>
    a aggr:Endpoint ;
    aggr:path "/healthz" ;
    hydra:supportedOperation <get-health-operation> .

<get-health-operation>
    a hydra:Operation ;
    hydra:method "GET" .

<readiness-endpoint>
    a aggr:Endpoint ;
    aggr:path "/readyz" ;
    hydra:supportedOperation <get-readiness-operation> .

<get-readiness-operation>
    a hydra:Operation ;
    hydra:method "GET" .
