@base <https://example.org/k8s-fl-services/federated-training-client/> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix aggr: <https://w3id.org/aggregator#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<deploy>
    a fno:Function ;
    fno:name "Deploy federated training client" ;
    fno:expects (
        <deploymentSources>
        <deploymentDataset>
        <deploymentAuthn>
        <deploymentPollEnabled>
        <deploymentPollInterval>
    ) ;
    fno:returns ( <deployedService> ) .

<deploymentSources>
    a fno:Parameter ;
    fno:predicate <sourcesValue> ;
    fno:type xsd:anyURI ;
    fno:required true .

<deploymentDataset>
    a fno:Parameter ;
    fno:predicate <datasetValue> ;
    fno:type xsd:string ;
    fno:required true .

<deploymentAuthn>
    a fno:Parameter ;
    fno:predicate <authnValue> ;
    fno:type xsd:anyURI ;
    fno:required true .

<deploymentPollEnabled>
    a fno:Parameter ;
    fno:predicate <pollEnabledValue> ;
    fno:type xsd:boolean ;
    fno:required false .

<deploymentPollInterval>
    a fno:Parameter ;
    fno:predicate <pollIntervalValue> ;
    fno:type xsd:string ;
    fno:required false .

<deployedService>
    a fno:Output ;
    fno:predicate <serviceValue> ;
    fno:type aggr:Service ;
    dct:conformsTo <profile> .

<prepare>
    a fno:Function ;
    fno:name "Prepare hospital data" ;
    fno:expects (
        <sources>
        <dataset>
        <authn>
        <pollEnabled>
        <pollInterval>
    ) ;
    fno:returns ( <preparedDataOutput> ) .

<train>
    a fno:Function ;
    fno:name "Train local model" ;
    fno:expects (
        <preparedDataInput>
        <sessionId>
        <clientId>
        <expectedRounds>
        <trainingConfig>
        <roundId>
        <replyUrl>
        <globalWeights>
    ) ;
    fno:returns (
        <clientWeights>
        <trainingMetrics>
        <evaluationDataOutput>
    ) .

<evaluate>
    a fno:Function ;
    fno:name "Evaluate aggregated model" ;
    fno:expects (
        <evaluationDataInput>
        <sessionId>
        <clientId>
        <trainingConfig>
        <roundId>
        <replyUrl>
        <globalWeights>
    ) ;
    fno:returns ( <evaluationMetrics> ) .

<sources>
    a fno:Parameter ;
    fno:predicate <sourcesValue> ;
    fno:type xsd:anyURI ;
    fno:required true .

<dataset>
    a fno:Parameter ;
    fno:predicate <datasetValue> ;
    fno:type xsd:string ;
    fno:required true .

<authn>
    a fno:Parameter ;
    fno:predicate <authnValue> ;
    fno:type xsd:anyURI ;
    fno:required true .

<pollEnabled>
    a fno:Parameter ;
    fno:predicate <pollEnabledValue> ;
    fno:type xsd:boolean ;
    fno:required false .

<pollInterval>
    a fno:Parameter ;
    fno:predicate <pollIntervalValue> ;
    fno:type xsd:string ;
    fno:required false .

<preparedDataOutput>
    a fno:Output ;
    fno:predicate <preparedDataValue> .

<preparedDataInput>
    a fno:Parameter ;
    fno:predicate <preparedDataValue> ;
    fno:type xsd:anyURI ;
    fno:required true .

<evaluationDataOutput>
    a fno:Output ;
    fno:predicate <evaluationDataValue> .

<evaluationDataInput>
    a fno:Parameter ;
    fno:predicate <evaluationDataValue> ;
    fno:type xsd:anyURI ;
    fno:required true .

<sessionId>
    a fno:Parameter ;
    fno:predicate <sessionIdValue> ;
    fno:type xsd:string ;
    fno:required true .

<clientId>
    a fno:Parameter ;
    fno:predicate <clientIdValue> ;
    fno:type xsd:string ;
    fno:required true .

<expectedRounds>
    a fno:Parameter ;
    fno:predicate <expectedRoundsValue> ;
    fno:type xsd:positiveInteger ;
    fno:required true .

<trainingConfig>
    a fno:Parameter ;
    fno:predicate <trainingConfigValue> ;
    fno:type xsd:string ;
    fno:required false .

<roundId>
    a fno:Parameter ;
    fno:predicate <roundIdValue> ;
    fno:type xsd:nonNegativeInteger ;
    fno:required true .

<replyUrl>
    a fno:Parameter ;
    fno:predicate <replyUrlValue> ;
    fno:type xsd:anyURI ;
    fno:required true .

<globalWeights>
    a fno:Parameter ;
    fno:predicate <globalWeightsValue> ;
    fno:type xsd:base64Binary ;
    fno:required true .

<clientWeights>
    a fno:Output ;
    fno:predicate <clientWeightsValue> .

<trainingMetrics>
    a fno:Output ;
    fno:predicate <trainingMetricsValue> .

<evaluationMetrics>
    a fno:Output ;
    fno:predicate <evaluationMetricsValue> .
