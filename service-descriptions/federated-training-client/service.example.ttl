@prefix aggr: <https://w3id.org/aggregator#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .

<https://aggregator.example/services/federated-training-client-1>
    a aggr:Service, dcat:DataService ;
    aggr:deploymentFunction
        <https://example.org/k8s-fl-services/federated-training-client/deploy> ;
    dcat:endpointURL
        <https://aggregator.example/services/federated-training-client-1/> ;
    dcat:servesDataset
        <https://aggregator.example/services/federated-training-client-1#prepared-data>,
        <https://aggregator.example/services/federated-training-client-1#weights>,
        <https://aggregator.example/services/federated-training-client-1#training-metrics>,
        <https://aggregator.example/services/federated-training-client-1#evaluation-data>,
        <https://aggregator.example/services/federated-training-client-1#evaluation-metrics> .

<https://aggregator.example/services/federated-training-client-1#prepared-data>
    a dcat:Dataset ;
    aggr:forOutput
        <https://example.org/k8s-fl-services/federated-training-client/preparedDataOutput> ;
    dcat:distribution
        <https://aggregator.example/services/federated-training-client-1#prepared-data-archive> .

<https://aggregator.example/services/federated-training-client-1#prepared-data-archive>
    a dcat:Distribution ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/zip> ;
    dcat:downloadURL
        <https://aggregator.example/services/federated-training-client-1/results> .

<https://aggregator.example/services/federated-training-client-1#weights>
    a dcat:Dataset ;
    aggr:forOutput
        <https://example.org/k8s-fl-services/federated-training-client/clientWeights> ;
    dcat:distribution
        <https://aggregator.example/services/federated-training-client-1#weights-distribution> .

<https://aggregator.example/services/federated-training-client-1#weights-distribution>
    a dcat:Distribution ;
    dcat:mediaType
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    dcat:downloadURL
        <https://aggregator.example/services/federated-training-client-1/weights> .

<https://aggregator.example/services/federated-training-client-1#training-metrics>
    a dcat:Dataset ;
    aggr:forOutput
        <https://example.org/k8s-fl-services/federated-training-client/trainingMetrics> ;
    dcat:distribution
        <https://aggregator.example/services/federated-training-client-1#training-metrics-distribution> .

<https://aggregator.example/services/federated-training-client-1#training-metrics-distribution>
    a dcat:Distribution ;
    dcat:mediaType
        <https://www.iana.org/assignments/media-types/application/json> ;
    dcat:accessURL
        <https://aggregator.example/services/federated-training-client-1/metrics> .

<https://aggregator.example/services/federated-training-client-1#evaluation-data>
    a dcat:Dataset ;
    aggr:forOutput
        <https://example.org/k8s-fl-services/federated-training-client/evaluationDataOutput> .

<https://aggregator.example/services/federated-training-client-1#evaluation-metrics>
    a dcat:Dataset ;
    aggr:forOutput
        <https://example.org/k8s-fl-services/federated-training-client/evaluationMetrics> ;
    dcat:distribution
        <https://aggregator.example/services/federated-training-client-1#evaluation-metrics-distribution> .

<https://aggregator.example/services/federated-training-client-1#evaluation-metrics-distribution>
    a dcat:Distribution ;
    dcat:mediaType
        <https://www.iana.org/assignments/media-types/application/json> ;
    dcat:accessURL
        <https://aggregator.example/services/federated-training-client-1/evaluation-metrics> .
