@base <https://example.org/k8s-fl-services/federated-training-client/> .
@prefix aggr: <https://w3id.org/aggregator#> .
@prefix fnoc: <https://fno.io/vocabulary/composition/0.1.0/> .
@prefix hydra: <http://www.w3.org/ns/hydra/core#> .

<profile>
    a aggr:ServiceProfile ;
    aggr:performs <prepare>, <train>, <evaluate> ;
    aggr:composition <client-data-flow> ;
    aggr:supportsEndpoint
        <prepared-data-endpoint>,
        <session-start-endpoint>,
        <train-endpoint>,
        <weights-endpoint>,
        <training-metrics-endpoint>,
        <evaluate-endpoint>,
        <evaluation-metrics-endpoint>,
        <session-end-endpoint> .

<client-data-flow>
    a fnoc:Composition ;
    fnoc:composedOf [
        fnoc:mapFrom [
            fnoc:constituentFunction <prepare> ;
            fnoc:functionOutput <preparedDataOutput>
        ] ;
        fnoc:mapTo [
            fnoc:constituentFunction <train> ;
            fnoc:functionParameter <preparedDataInput>
        ]
    ], [
        fnoc:mapFrom [
            fnoc:constituentFunction <train> ;
            fnoc:functionOutput <evaluationDataOutput>
        ] ;
        fnoc:mapTo [
            fnoc:constituentFunction <evaluate> ;
            fnoc:functionParameter <evaluationDataInput>
        ]
    ] .

<prepared-data-endpoint>
    a aggr:Endpoint ;
    aggr:path "/results" ;
    hydra:supportedOperation <get-prepared-data-operation> .

<get-prepared-data-operation>
    a hydra:Operation ;
    hydra:method "GET" ;
    aggr:returnsOutput <preparedDataOutput> .

<session-start-endpoint>
    a aggr:Endpoint ;
    aggr:path "/session/start" ;
    hydra:supportedOperation <session-start-operation> .

<session-start-operation>
    a hydra:Operation ;
    hydra:method "POST" ;
    aggr:updatesParameter
        <sessionId>, <clientId>, <expectedRounds>, <trainingConfig> .

<train-endpoint>
    a aggr:Endpoint ;
    aggr:path "/train" ;
    hydra:supportedOperation <train-operation> .

<train-operation>
    a hydra:Operation ;
    hydra:method "POST" ;
    aggr:executes <train> ;
    aggr:updatesParameter <roundId>, <replyUrl>, <globalWeights> .

<weights-endpoint>
    a aggr:Endpoint ;
    aggr:path "/weights" ;
    hydra:supportedOperation <get-weights-operation> .

<get-weights-operation>
    a hydra:Operation ;
    hydra:method "GET" ;
    aggr:returnsOutput <clientWeights> .

<training-metrics-endpoint>
    a aggr:Endpoint ;
    aggr:path "/metrics" ;
    hydra:supportedOperation <get-training-metrics-operation> .

<get-training-metrics-operation>
    a hydra:Operation ;
    hydra:method "GET" ;
    aggr:returnsOutput <trainingMetrics> .

<evaluate-endpoint>
    a aggr:Endpoint ;
    aggr:path "/evaluate" ;
    hydra:supportedOperation <evaluate-operation> .

<evaluate-operation>
    a hydra:Operation ;
    hydra:method "POST" ;
    aggr:executes <evaluate> ;
    aggr:updatesParameter <roundId>, <replyUrl>, <globalWeights> .

<evaluation-metrics-endpoint>
    a aggr:Endpoint ;
    aggr:path "/evaluation-metrics" ;
    hydra:supportedOperation <get-evaluation-metrics-operation> .

<get-evaluation-metrics-operation>
    a hydra:Operation ;
    hydra:method "GET" ;
    aggr:returnsOutput <evaluationMetrics> .

<session-end-endpoint>
    a aggr:Endpoint ;
    aggr:path "/session/end" ;
    hydra:supportedOperation <session-end-operation> .

<session-end-operation>
    a hydra:Operation ;
    hydra:method "POST" ;
    aggr:updatesParameter
        <sessionId>, <clientId>, <expectedRounds>, <trainingConfig> .
